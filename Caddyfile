{
    # Matikan admin API internal Caddy
    admin off
}

:{$PORT:80} {
    # Document root Laravel
    root * /app/public

    # Aktifkan kompresi response
    encode zstd gzip

    # Serve static assets langsung (CSS, JS, Video MP4, gambar, fonts)
    file_server

    # Forward semua dynamic route Laravel ke public/index.php
    php_server {
        try_files {path} index.php
    }
}
