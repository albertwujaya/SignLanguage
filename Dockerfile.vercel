# --- Stage 1: Build composer vendor dependencies ---
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-scripts \
    --no-progress \
    --prefer-dist \
    --optimize-autoloader

# --- Stage 2: Production Runtime FrankenPHP (PHP 8.4 Alpine) ---
FROM dunglas/frankenphp:1-alpine AS runner

WORKDIR /app

# Install ekstensi PHP yang dibutuhkan Laravel & PostgreSQL Supabase
RUN install-php-extensions \
    pdo_pgsql \
    pdo_mysql \
    pdo_sqlite \
    opcache \
    intl \
    zip \
    bcmath

# Salin Caddyfile
COPY Caddyfile /etc/caddy/Caddyfile

# Salin seluruh source code aplikasi Laravel (termasuk folder public/ yang berisi asset build & video gesture)
COPY . /app

# Salin folder vendor dari stage composer
COPY --from=vendor /app/vendor /app/vendor

# Pastikan folder temporary writable
RUN mkdir -p /app/storage/framework/views \
             /app/storage/framework/cache/data \
             /app/storage/framework/sessions \
             /app/storage/logs \
             /app/bootstrap/cache \
    && chown -R www-data:www-data /app/storage /app/bootstrap/cache \
    && chmod -R 775 /app/storage /app/bootstrap/cache

# Bind default port ke 80
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr

EXPOSE 80

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
