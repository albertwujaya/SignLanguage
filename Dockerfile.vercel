FROM dunglas/frankenphp:1-php8.4-bookworm AS runtime

RUN install-php-extensions intl zip bcmath pdo_pgsql pdo_sqlite pdo_mysql

WORKDIR /app

COPY . .

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
RUN composer install --no-dev --no-interaction --optimize-autoloader --ignore-platform-reqs

COPY Caddyfile /etc/frankenphp/Caddyfile
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Ensure storage, cache, and database exist with correct permissions
RUN mkdir -p /app/database /app/storage /app/bootstrap/cache /tmp/views \
    && touch /app/database/database.sqlite \
    && chown -R www-data:www-data /app/storage /app/bootstrap/cache /app/database /tmp/views \
    && chmod -R 775 /app/storage /app/bootstrap/cache /app/database /tmp/views

ENV APP_NAME=Signesia
ENV APP_ENV=production
ENV APP_KEY=base64:xx4dZCavzneG2P+eQyQW63QjbQ/YK1HsoiS/3KyLjDU=
ENV APP_DEBUG=false
ENV LOG_CHANNEL=stderr
ENV DB_CONNECTION=sqlite
ENV DB_DATABASE=/app/database/database.sqlite
ENV SESSION_DRIVER=cookie
ENV CACHE_STORE=array
ENV VIEW_COMPILED_PATH=/tmp/views
ENV ADMIN_EMAIL=admin@email.com
ENV ADMIN_PASSWORD=admin1234567

ENTRYPOINT ["docker-entrypoint.sh"]
